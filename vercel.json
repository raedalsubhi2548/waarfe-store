{
  "cleanUrls": true,
  "rewrites": [{ "source": "/((?!api/|assets/).*)", "destination": "/200" }],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/brand/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }] }
  ]
}
