# Leave both empty to run in demo mode (data saved in the browser).
# Fill them from Supabase → Project Settings → API to go live.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# WhatsApp number for support buttons (international format, no +)
# Cloudflare Turnstile site key (public). The secret goes in Supabase → Authentication → Attack Protection.
VITE_TURNSTILE_SITE_KEY=
